<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- HTTP is encrypted by the peer-authenticated FIPS mesh. Native requests
         additionally require an enrolled provider grant and pinned VPN sockets. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">fips</domain>
    </domain-config>
</network-security-config>
